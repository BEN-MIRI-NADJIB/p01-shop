<mxfile host="app.diagrams.net">
  <diagram name="Event Storming P1" id="p1-ddd">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Contextes (Boîtes bleues) -->
        <mxCell id="ctx-id" value="IDENTITY&#xa;(Authentification)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ctx-cat" value="CATALOG&#xa;(Produits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="180" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ctx-ord" value="ORDERS&#xa;(Commandes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="180" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ctx-inv" value="INVENTORY&#xa;(Stock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="700" y="180" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ctx-pay" value="PAYMENT&#xa;(Paiement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="180" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ctx-not" value="NOTIFICATIONS&#xa;(Alertes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="180" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Événements normaux (Post-its orange) -->
        <mxCell id="ev-placed" value="OrderPlaced" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="70" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ev-stock" value="StockReserved" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ev-pay" value="PaymentCaptured" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="1090" y="70" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ev-conf" value="OrderConfirmed" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="1090" y="290" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Compensation (Post-its rouges) -->
        <mxCell id="ev-fail" value="PaymentFailed" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="840" y="340" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ev-canc" value="OrderCancelled&#xa;(Compensation)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="340" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Flux normal -->
        <mxCell id="e1" edge="1" parent="1" source="ctx-ord" target="ev-placed" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="ev-placed" target="ctx-inv" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="ctx-inv" target="ev-stock" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="ev-stock" target="ctx-pay" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="ctx-pay" target="ev-pay" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="ev-pay" target="ctx-not" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="ctx-pay" target="ev-conf" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="ev-conf" target="ctx-ord" style="edgeStyle=orthogonalEdgeStyle;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Flux d'échec -->
        <mxCell id="f1" edge="1" parent="1" source="ctx-pay" target="ev-fail" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" edge="1" parent="1" source="ev-fail" target="ctx-inv" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" edge="1" parent="1" source="ev-fail" target="ev-canc" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" edge="1" parent="1" source="ev-canc" target="ctx-ord" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>